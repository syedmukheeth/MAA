# MAA FURNITURE — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not (see the
# `!.env.example` negation in .gitignore).
#
# Every variable below is read somewhere in src/ — the file reference after each
# one is where. Nothing else is consulted at runtime.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection string.                                   src/lib/db.ts
# Supabase: use the TRANSACTION-mode pooler (port 6543), not session mode —
# db.ts caps the pool at 2 so serverless workers stay under the 15-connection
# session limit.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Leave UNSET in production. SSL is on by default because Supabase requires it;
# set to "false" only against a local Postgres that serves no TLS, otherwise
# `pg` fails with "server does not support SSL connections".   src/lib/db.ts
# DATABASE_SSL=false

# Optional. Supabase's root CA, as PEM or base64.                src/lib/db.ts
# Unset: the connection is encrypted but the chain is not verified (equivalent
# to sslmode=require). Set: the chain IS verified. Get it from Supabase
# Dashboard -> Settings -> Database -> SSL certificate. Do NOT turn on
# certificate verification without this — Supabase's root is not in Node's
# trust store, and every query dies with SELF_SIGNED_CERT_IN_CHAIN.
# DATABASE_CA_CERT=

# Signs the 7-day session JWT.                            src/lib/auth/jwt.ts
# REQUIRED — the server will refuse to start without this.
# Must be at least 32 characters. Generate a secure value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every existing session.
JWT_SECRET=

# Upstash Redis, used only for rate limiting.                src/lib/redis.ts
# Login/register/forgot-password limiters fail OPEN (a limiter must never be
# the reason nobody can sign in); /api/custom-requests fails CLOSED. The
# asymmetry is deliberate — see HANDOVER.md Phase 0/Phase 1.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email (order confirmations, password resets).
#                                                            src/lib/email.ts
# The Resend client is constructed at module load, so an absent value throws
# during `next build` page-data collection — not just at send time.
RESEND_API_KEY=

# Authorises the nightly erasure cron.
#                              src/app/api/privacy/execute-erasures/route.ts
# REQUIRED once DPDP account deletion is live. The route fails CLOSED without
# it — scheduled erasures simply never run, which is the safe failure but also
# a silent breach of the deletion promise, so set it and check the cron log.
# Vercel sends this automatically as `Authorization: Bearer <value>` when the
# variable is named CRON_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Direct (non-pooled) Postgres connection, port 5432. Used by `prisma migrate`,
# which cannot run DDL through the transaction pooler.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# The DPDP grievance officer published in the privacy notice and on /grievance.
#                                              src/lib/privacy/constants.ts:31
# REQUIRED before handover. Unset, the notice names the developer and a personal
# gmail address — DPDP §13 expects the business's own accountable person at the
# business's own address, and a grievance sent to the wrong inbox is an
# unanswered grievance.
DPO_NAME=
DPO_EMAIL=
# Optional. Falls back to the showroom phone in site settings.
# DPO_PHONE=

# ── Optional ────────────────────────────────────────────────────────────────

# Supabase project credentials. Not used by the app at runtime — kept for the
# Supabase CLI and dashboard tooling.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Staff provisioning, read only by `npm run db:staff`
#                                          prisma/scripts/upsert-staff.ts:38
# Emails default to owner@/admin@/manager@maafurnitures.com. Leave the passwords
# unset and the script generates them, writing them to a gitignored
# staff-credentials.local.txt instead of the terminal. Either way the account is
# created with mustChangePassword, so the value is good for exactly one login.
# STAFF_OWNER_EMAIL=
# STAFF_OWNER_NAME=
# STAFF_OWNER_PASSWORD=
# STAFF_ADMIN_EMAIL=
# STAFF_ADMIN_NAME=
# STAFF_ADMIN_PASSWORD=
# STAFF_MANAGER_EMAIL=
# STAFF_MANAGER_NAME=
# STAFF_MANAGER_PASSWORD=

# Local development seed only — `prisma/seed.ts` refuses to run against anything
# but a localhost database, and has no default passwords. Never set these in
# production; use the STAFF_* variables above with `npm run db:staff` instead.
# SEED_OWNER_EMAIL=
# SEED_OWNER_NAME=
# SEED_OWNER_PASSWORD=
# SEED_MANAGER_EMAIL=
# SEED_MANAGER_NAME=
# SEED_MANAGER_PASSWORD=

# Sender identity. Falls back to Resend's shared onboarding sender.
#                                                          src/lib/email.ts:5
# The domain must be verified in Resend or every send is rejected — which means
# nobody can complete a password reset. Verify it before handing over accounts.
EMAIL_FROM="MAA FURNITURE <support@maafurniture.shop>"

# Canonical origin for sitemap, OpenGraph and JSON-LD absolute URLs.
#                                                         src/lib/site-url.ts
# Wins over Vercel's VERCEL_PROJECT_PRODUCTION_URL. Defaults to
# http://localhost:3000 when neither is set. Set this once a domain is live —
# without it, production link previews point at localhost.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Product/combo image uploads. Without these the admin upload flow is dead,
# but the storefront still renders existing images.    src/lib/cloudinary.ts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay payments (Test or Live keys).                     src/lib/razorpay.ts
# Sign up at https://dashboard.razorpay.com/signup for free test keys.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

