generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CUSTOMER
}

enum RefundStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSED
  FAILED
}

/// Purposes for which consent (DPDP §6) is the lawful basis.
///
/// Deliberately short. Almost nothing this app does runs on consent: accounts,
/// orders, shipping snapshots and invoices are contract performance, GST
/// retention is a legal obligation, and rate limiting is a security measure —
/// all separate legitimate uses under §7. Adding a checkbox for those would be
/// a lie the customer could untick, which would then break checkout.
enum ConsentPurpose {
  MARKETING_EMAIL
  TESTIMONIAL_PUBLICATION
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum ConsentSource {
  REGISTRATION
  ACCOUNT_PRIVACY_PAGE
  STAFF_RECORDED
}

enum PrivacyRequestType {
  EXPORT
  CORRECTION
  ERASURE
  GRIEVANCE
}

enum PrivacyRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  ON_HOLD
  CANCELLED
}

model SiteSettings {
  id String @id @default("singleton")

  /// Displayed prices are GST-inclusive (Indian B2C retail norm). This rate is
  /// used to break the tax component OUT of the total for invoicing, not to add
  /// it on top. Stored per-order at purchase time so historical orders keep the
  /// rate they were actually charged.
  gstRate Decimal @default(18) @db.Decimal(5, 2)

  /// Flat delivery fee added to the order. Waived above the threshold.
  deliveryFee           Decimal  @default(0) @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(10, 2)

  heroHeadline    String
  heroSubtext     String
  heroImageUrl    String

  brandLabel      String
  brandHeadline   String

  statYearsExperience   Int
  statProjectsDelivered Int
  statHappyFamilies     Int
  statGoogleRating      String

  showroomAddress  String
  showroomHours    String
  showroomPhone    String
  showroomWhatsapp String

  instagramUrl String?
  facebookUrl  String?

  deliveryMessage String

  /// Master switch for buying. False = catalogue-only: the storefront still
  /// lists everything, but add-to-cart and checkout are refused server-side.
  allowPurchases Boolean @default(true)

  allowCOD   Boolean @default(true)
  allowUPI   Boolean @default(true)
  upiId      String?
  upiQrImage String?

  /// JSON array of enabled RoomCategory keys, e.g. ["LIVING_ROOM","BEDROOM"].
  /// Null means all categories are shown (default behaviour).
  shopSections   String?
  /// JSON array of admin-defined extra shop sections, e.g.
  /// [{"label":"Wardrobes","query":"wardrobe"}]. Rendered as extra filter pills.
  shopCustomSections String?
  /// JSON arrays for Custom Studio dropdowns. Null = use built-in defaults.
  studioWoods    String?
  studioFinishes String?
  studioBudgets  String?
  /// JSON array of admin-defined extra studio features, e.g.
  /// [{"label":"Handle Style","options":["Brass","Steel"]}].
  studioFeatures String?

  updatedAt DateTime @updatedAt
}

enum RoomCategory {
  LIVING_ROOM
  BEDROOM
  DINING
  OFFICE
  OUTDOOR
}

enum RequestStatus {
  NEW
  IN_REVIEW
  QUOTED
  CONVERTED
  CLOSED
}

enum StockMovementType {
  RECEIVED
  SOLD
  RETURNED
  DAMAGED
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  /// Incremented on password change and role change. JWTs carry the version at
  /// issue time; any token whose version is behind the current value is rejected.
  tokenVersion Int      @default(0)
  /// Set when a DPDP erasure request has been executed against this row. The
  /// row itself survives because Order, Cart and AuditLog reference it with
  /// onDelete: Restrict and orders are a statutory accounting record — what is
  /// destroyed is the identifying content, not the FK anchor. A non-null value
  /// means name/email/passwordHash are tombstones, not real data.
  erasedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products                Product[]                @relation("ProductCreatedBy")
  combos                  Combo[]                   @relation("ComboCreatedBy")
  customFurnitureRequests CustomFurnitureRequest[]  @relation("SubmittedBy")
  testimonials            Testimonial[]             @relation("TestimonialCreatedBy")
  testimonialsAbout       Testimonial[]             @relation("TestimonialSubject")
  auditLogs               AuditLog[]                @relation("AuditActor")
  cart                    Cart?
  orders                  Order[]
  addresses               Address[]
  consentRecords          ConsentRecord[]
  privacyRequests         PrivacyRequest[]

  @@index([role])
  @@index([erasedAt])
}

/// Evidence that consent was given or withdrawn, for one purpose, at one time.
///
/// APPEND-ONLY. A grant or a withdrawal inserts a new row; nothing is ever
/// updated in place. DPDP §6(1) puts the burden of proving consent on the data
/// fiduciary, and a single mutable row per purpose destroys exactly the history
/// that discharges it. Current state is the newest row per (userId, purpose) —
/// which is why there is deliberately no @@unique on that pair.
///
/// `noticeVersion` copies PRIVACY_NOTICE_VERSION at grant time so it is always
/// possible to say which text the person actually read.
///
/// onDelete: Restrict — these survive an erasure (status flipped to WITHDRAWN)
/// because they are the record of what you were entitled to do. Deleting them
/// destroys your own defence.
model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose       ConsentPurpose
  status        ConsentStatus
  grantedAt     DateTime       @default(now())
  withdrawnAt   DateTime?
  noticeVersion String
  source        ConsentSource
  createdAt     DateTime       @default(now())

  @@index([userId, purpose, grantedAt])
}

/// A data principal's exercise of a DPDP right, and its resolution.
///
/// Covers export, correction, erasure and grievance in one queue so the 30-day
/// response clock is visible in a single place.
model PrivacyRequest {
  id String @id @default(cuid())
  /// Null only for grievances raised from the public page by someone with no
  /// account — or whose account is already locked pending erasure and who wants
  /// to cancel. Every other request type is created behind requireAuth() and
  /// always has one.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Reply address for a request with no account behind it. Deliberately the
  /// only personal data the public grievance form collects — without it there
  /// is no way to answer the complaint. Never populated when userId is set:
  /// duplicating an address we already hold would be collection for nothing.
  contactEmail String?
  type   PrivacyRequestType
  status PrivacyRequestStatus @default(PENDING)
  /// The data principal's own words (grievance body, correction detail).
  /// Never staff notes — those go in `resolution`.
  note        String?
  /// Staff-authored outcome, shown back to the principal on completion.
  resolution  String?
  requestedAt DateTime  @default(now())
  /// ERASURE only: end of the cooling-off window, after which the cron executes.
  /// Null for every other type.
  scheduledFor DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

/// Reusable saved delivery addresses. Customers manage these from their
/// profile; checkout pre-fills from the default one.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Product {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  description       String
  price             Decimal      @db.Decimal(10, 2)
  /// Compare-at price (MRP). Shown struck-through when greater than price.
  mrp               Decimal?     @db.Decimal(10, 2)
  category          RoomCategory
  materials         String[]
  dimensions        String?
  images            String[]
  stockQuantity     Int          @default(0)
  lowStockThreshold Int          @default(5)
  featured          Boolean      @default(false)
  /// Soft deactivate: inactive products are hidden from the storefront and
  /// block any combo that contains them, without destroying order history.
  isActive          Boolean      @default(true)
  createdById       String
  createdBy         User         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  comboItems        ComboItem[]
  cartItems         CartItem[]
  variants          Variant[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([category])
  @@index([featured])
}

model Variant {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name              String
  woodType          String?
  finish            String?
  size              String?
  priceDelta        Decimal         @default(0) @db.Decimal(10, 2)
  sku               String?         @unique
  stock             Int             @default(0)
  lowStockThreshold Int             @default(3)
  isDefault         Boolean         @default(false)
  image             String?
  cartItems         CartItem[]
  orderItems        OrderItem[]
  movements         StockMovement[]
  comboItemOptions  ComboItemOption[]
  comboSelections   CartComboSelection[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([productId, name])
  @@index([productId])
}

model StockMovement {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      StockMovementType
  qty       Int
  reason    String?
  orderId   String?
  byUserId  String?
  createdAt DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

model Combo {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  bundlePrice Decimal     @db.Decimal(10, 2)
  image       String?
  isActive    Boolean     @default(true)
  items       ComboItem[]
  cartItems   CartItem[]
  createdById String
  createdBy   User        @relation("ComboCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive])
}

model ComboItem {
  id        String            @id @default(cuid())
  comboId   String
  combo     Combo             @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  quantity  Int               @default(1)
  /// Variants the manager allows the customer to choose for this item.
  /// Empty = fixed item, storefront shows "no other options available".
  options        ComboItemOption[]
  cartSelections CartComboSelection[]

  @@unique([comboId, productId])
}

model ComboItemOption {
  id          String    @id @default(cuid())
  comboItemId String
  comboItem   ComboItem @relation(fields: [comboItemId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([comboItemId, variantId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])
  comboId   String?
  combo     Combo?   @relation(fields: [comboId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comboSelections CartComboSelection[]

  @@unique([cartId, variantId])
  @@unique([cartId, comboId])
}

/// Customer's chosen variant for one option-bearing item inside a combo cart line.
model CartComboSelection {
  id          String    @id @default(cuid())
  cartItemId  String
  cartItem    CartItem  @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  comboItemId String
  comboItem   ComboItem @relation(fields: [comboItemId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant   @relation(fields: [variantId], references: [id])

  @@unique([cartItemId, comboItemId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  status          OrderStatus @default(PENDING)

  /// Sum of line totals. GST-INCLUSIVE — this is what the customer saw.
  subtotal Decimal @db.Decimal(10, 2)
  /// Delivery charge applied at purchase time.
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  /// The GST rate in force when this order was placed. Frozen deliberately:
  /// if the rate changes, past invoices must not silently change with it.
  taxRate Decimal @default(0) @db.Decimal(5, 2)
  /// The GST component contained WITHIN (subtotal + deliveryFee). Not added on.
  taxAmount Decimal @default(0) @db.Decimal(10, 2)
  /// subtotal + deliveryFee. What the customer pays.
  total Decimal @db.Decimal(10, 2)

  paymentMethod   String      @default("COD")
  cancelReason    String?
  refundStatus    RefundStatus @default(NOT_APPLICABLE)
  refundAmount    Decimal?     @db.Decimal(10, 2)
  refundTxnId     String?
  refundNotes     String?
  refundedAt      DateTime?
  shippingName    String
  shippingPhone   String
  shippingLine1   String
  shippingLine2   String?
  shippingCity    String
  shippingState   String
  shippingPincode String
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  comboId     String?
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantName String?
  name        String
  /// Human-readable snapshot of per-item option choices for combo lines,
  /// e.g. "Dining Table: Teak / Walnut; Chairs: Oak".
  optionsSummary String?
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal  @db.Decimal(10, 2)
}

/// Real customer testimonials, entered by staff.
///
/// This model exists so the storefront never has to fabricate one. The section
/// renders nothing when there are no published rows — an empty trust block is
/// honest; an invented one is a consumer-protection problem (CCPA / BIS
/// IS 19000:2022) and destroys the exact trust it pretends to build.
model Testimonial {
  id          String   @id @default(cuid())
  name        String
  location    String?
  quote       String
  rating      Int      @default(5)
  imageUrl    String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdById String?
  createdBy   User?    @relation("TestimonialCreatedBy", fields: [createdById], references: [id])
  /// The customer this testimonial is ABOUT, when they have an account.
  ///
  /// Distinct from `createdById`, which is the staff member who typed it in.
  /// Without this link an erasure request cannot find the published row naming
  /// that person — the name here is free text and unjoinable. Nullable because
  /// legacy rows predate it and some quotes come from walk-in customers.
  subjectUserId String?
  subjectUser   User?   @relation("TestimonialSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  /// The ConsentRecord that permits publication. Required in practice by the
  /// publish guard in actions/testimonials.ts, not by the database, so that
  /// unpublished drafts can be saved before consent is obtained.
  consentRecordId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([subjectUserId])
}

/// Who changed what. Required by ULTRAPLAN §2 and previously absent entirely —
/// nothing recorded who altered a price, deleted a product, cancelled an order,
/// or granted a role. With three staff tiers touching money and stock, this is
/// the primary internal control.
model AuditLog {
  id       String  @id @default(cuid())
  actorId  String
  actor    User    @relation("AuditActor", fields: [actorId], references: [id])
  /// Dotted action, e.g. "product.delete", "user.role_change".
  action   String
  entity   String
  entityId String?
  /// Human-readable one-liner for the admin table.
  summary  String?
  /// Before/after detail. Never store secrets here.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model CustomFurnitureRequest {
  id             String        @id @default(cuid())
  name           String
  phone          String
  inspirationUrl String?
  imageUrl       String?
  dimensions     String?
  wood           String?
  finish         String?
  budgetRange    String?
  description    String?
  /// JSON object of admin-defined custom feature answers, e.g.
  /// {"Handle Style":"Brass"}. Null when no custom features were configured.
  customOptions  String?
  status         RequestStatus @default(NEW)
  submittedById  String?
  submittedBy    User?         @relation("SubmittedBy", fields: [submittedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}
